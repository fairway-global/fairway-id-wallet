{
  "typescript.tsdk": "node_modules/typescript/lib", // Use the project-specific TypeScript version
  "editor.formatOnSave": true, // Format files on save
  "editor.defaultFormatter": "esbenp.prettier-vscode", // Use Prettier as the default formatter
  "files.exclude": {
    "**/.next": true, // Exclude Next.js build files
    "**/node_modules": true
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact",
    "javascriptreact"
  ], // Enable ESLint for supported files
  "typescript.preferences.importModuleSpecifier": "relative", // Use relative imports for IntelliSense
  "typescript.autoImportSuggestions.enabled": true // Enable auto-import suggestions
}
